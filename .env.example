# Orbix loads this file automatically from the project root on server start.
# Copy to .env and replace both placeholders. Never commit .env.

# ==================== ENV FILE LOCATION ====================
# Optional. Overrides which dotenv file is loaded at startup. Defaults to
# <project root>/.env. Real process variables always win over the file, so
# `uvicorn --env-file`, Docker and shell exports keep precedence.
# ORBIX_ENV_FILE=/etc/orbix/orbix.env

# ==================== DATABASE - ROOT LEVEL CONFIG ====================
# All database config lives at root level, shared by the web and mobile clients
# Single source of truth: database/ folder + data/ folder at root

# Data directory - at root level, holds all DB files
# Default: ./data at root, contains orbix.sqlite3, candles.duckdb, mobile/, models/
ORBIX_DATA_DIR=./data
# DATABASE_DATA_DIR=./data  # alias
# ORBIX_MOBILE_DATA_DIR=./data/mobile

# Backend - auto-detects if not set
# auto: Supabase > Postgres > DuckDB > SQLite (default fallback)
# sqlite: force SQLite - works everywhere, no native libs, offline
# duckdb: force DuckDB - analytics, fast for candles, web default
# postgres: force Postgres - production
# supabase: force Supabase - cloud sync, free 500MB
DATABASE_BACKEND=auto
# ORBIX_DATABASE_BACKEND=auto  # alias
# ORBIX_USE_DUCKDB=1  # force DuckDB
# ORBIX_MOBILE=1  # force SQLite for mobile

# SQLite - no extra config, uses ORBIX_DATA_DIR/orbix.sqlite3
# WAL mode for concurrency
DATABASE_WAL_MODE=true
DATABASE_AUTO_MIGRATE=true

# DuckDB - uses ORBIX_DATA_DIR/candles.duckdb

# Postgres - production, local or cloud
# DATABASE_URL=postgres://orbix:orbix@localhost:5432/orbix
# POSTGRES_URL=postgres://user:pass@host:port/db

# Supabase - optional cloud sync, free tier 500MB
# Get from https://app.supabase.com/project/_/settings/api
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_KEY=eyJ...  # bypasses RLS - server-side ONLY, never ship to a client

# Optional storage override. Defaults to ./data next to the package.
# ORBIX_DATA_DIR=/var/lib/orbix
# Dashboard login. Leave both password fields empty only when the app is
# reachable solely from this machine. With a password set, every page redirects
# to /login and every API route needs a signed 7-day session cookie; HTTP Basic
# auth keeps working for scripts. Use HTTPS in front of it.
ORBIX_DASHBOARD_USER=orbix
ORBIX_DASHBOARD_PASSWORD=
# Preferred for shared servers: a PBKDF2-SHA256 hash instead of plaintext.
# Generate one with: python -m orbix.security
# When both are set the hash wins.
ORBIX_DASHBOARD_PASSWORD_HASH=
# Signing key for session cookies. Leave empty to generate a 0600 file inside
# ORBIX_DATA_DIR (sessions survive restarts). Set an explicit long random value
# when the data directory is ephemeral or read-only.
ORBIX_SESSION_SECRET=
# Force the session cookie's Secure flag (1/0). Auto-detects HTTPS otherwise.
# ORBIX_COOKIE_SECURE=
# Allow this page to load inside an iframe, for a trusted preview host only.
# Leave this unset in production: it removes X-Frame-Options and the CSP
# frame-ancestors guard.
# ORBIX_ALLOW_EMBED=
# Optional location for keys saved from the Connections page. Defaults to
# provider_settings.json inside ORBIX_DATA_DIR. The file is chmod 600 and is
# never returned to the browser. Environment variables above still win.
# ORBIX_PROVIDER_SETTINGS_FILE=/var/lib/orbix/provider_settings.json
ORBIX_TWELVE_DATA_API_KEY=replace_with_your_twelve_data_key
ORBIX_FINNHUB_API_KEY=replace_with_your_finnhub_key

# M1 automatic feed and research settings
ORBIX_MARKET_PAIR=EUR/USD
ORBIX_MARKET_REFRESH_SECONDS=60
ORBIX_NEWS_REFRESH_SECONDS=900
ORBIX_FINNHUB_TIMEZONE=UTC
ORBIX_NEWS_BEFORE_MINUTES=15
ORBIX_NEWS_AFTER_MINUTES=30
ORBIX_MAX_ENTRY_DELAY_SECONDS=10
ORBIX_MAX_BAR_AGE_SECONDS=180
# orbix_cadence collects roughly one model read every three minutes.
# orbix_confluence is the stricter 5/6 gate (far fewer signals).
ORBIX_AUTO_STRATEGY=orbix_cadence
ORBIX_AUTO_SIGNALS=true
# Watch imported datasets for newly appended fresh bars and generate paper-only
# signals without a market-provider key. Telegram auto-post never applies.
ORBIX_AUTO_IMPORTED=true
ORBIX_IMPORTED_MAX_ENTRY_DELAY_SECONDS=120

# Cadence and hard limits for the automatic signal path. The default collects
# roughly one paper signal every three minutes inside the UTC windows below.
# This is a collection profile, not a profitability claim: 1,500 real EUR/USD
# bars produced 149 signals at 43.4% (95% CI 35.3-51.8%), below the 55.6%
# break-even at an 80% payout. The rules can only remove trades, never add one.
# For the old disciplined profile use 6 / 20 / 3 / 2 / 30 / 20 / 0.45 and
# ORBIX_AUTO_STRATEGY=orbix_confluence.
ORBIX_DISCIPLINE=true
ORBIX_TRADING_SESSIONS=07:00-11:00,12:30-16:30
ORBIX_WEEKDAYS_ONLY=true
ORBIX_SESSION_QUIET_MINUTES=10
ORBIX_MAX_SIGNALS_PER_DAY=200
ORBIX_MIN_SIGNAL_SPACING_MINUTES=3
ORBIX_MAX_DAILY_LOSSES=100
ORBIX_COOLDOWN_AFTER_LOSSES=12
ORBIX_COOLDOWN_MINUTES=10
ORBIX_MAX_OPEN_TRADES=1
ORBIX_CONTEXT_MIN_SAMPLES=200
ORBIX_CONTEXT_MIN_WIN_RATE=0.40

# Prediction and self-learning engine.
# Calibration needs at least 60 resolved, non-synthetic outcomes. Ensemble
# spread above the limit causes abstention rather than a guessed direction.
ORBIX_ENSEMBLE_SIZE=3
ORBIX_MAX_UNCERTAINTY=0.10
ORBIX_MAX_UPDATE_DEGRADATION=0.02
ORBIX_RECALIBRATE_EVERY=50
# Resolved outcomes required before the replay rollback guard engages.
ORBIX_MIN_LEARNING_SAMPLES=30
ORBIX_VALIDATION_FRACTION=0.15
# One test-before-learn outcome per completed imported bar, signal or not.
ORBIX_DATASET_LEARNING=true

# Telegram one-click delivery (optional). Keep the bot token server-side.
# 1. Create the bot with @BotFather. 2. Add it to the channel as an
# administrator with "Post messages". 3. Use the -100... id or @channelname.
ORBIX_TELEGRAM_BOT_TOKEN=
ORBIX_TELEGRAM_CHAT_ID=
ORBIX_TELEGRAM_TIMEZONE=Asia/Kolkata
# Auto-post new live signals and their paper results. Off by default.
ORBIX_TELEGRAM_AUTO_POST=false
# Volume guardrails. The cap counts channel messages per UTC day (manual sends
# included); the cooldown spaces out automatic posts.
ORBIX_TELEGRAM_DAILY_CAP=40
ORBIX_TELEGRAM_COOLDOWN_SECONDS=60

# ==================== CSV UPLOAD LIMITS ====================
# Caps for the streamed CSV endpoints, in megabytes. /api/import replaces the
# active dataset; /api/candles/append adds completed bars to it.
#
# The import cap used to be a hard-coded 1 GiB, which at ~75 bytes per
# one-minute candle is about 26 years of continuous data - far past the largest
# window the app reads (backtest 2500, model training 5000, stored tail 10000).
# A cap that large is not a limit, so the defaults are bounded and the server
# also refuses an upload when the data volume lacks free space for it.
ORBIX_MAX_IMPORT_MB=256
ORBIX_MAX_APPEND_MB=64
