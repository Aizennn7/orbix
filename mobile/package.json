{
  "name": "orbix-mobile",
  "version": "0.4.0",
  "description": "Orbix Signal Lab - Mobile APK with offline database, all-in-one",
  "main": "src/js/app.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:init": "npx cap init Orbix com.orbix.signallab --web-dir=dist",
    "cap:add": "npx cap add android",
    "cap:copy": "npx cap copy",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "android:build": "npm run build && npx cap copy && cd android && ./gradlew assembleDebug",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.0",
    "@capacitor/android": "^6.1.0",
    "@capacitor-community/sqlite": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "vite": "^5.4.0"
  },
  "capacitor": {
    "appId": "com.orbix.signallab",
    "appName": "Orbix Signal Lab",
    "webDir": "dist",
    "server": {
      "androidScheme": "https"
    },
    "plugins": {
      "CapacitorSQLite": {
        "iosDatabaseLocation": "Library/CapacitorDatabase",
        "androidIsEncryption": false,
        "androidBiometric": {
          "biometricAuth": false,
          "biometricTitle": "Biometric login for Orbix"
        }
      },
      "SplashScreen": {
        "launchShowDuration": 2000,
        "backgroundColor": "#050505"
      },
      "StatusBar": {
        "style": "DARK",
        "backgroundColor": "#050505"
      }
    }
  }
}
